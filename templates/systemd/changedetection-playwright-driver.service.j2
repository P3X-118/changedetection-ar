[Unit]
Description=Changedetection.io Playwright driver ({{ changedetection_playwright_driver_identifier }})
{% for service in changedetection_playwright_driver_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in changedetection_playwright_driver_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ changedetection_playwright_driver_identifier }} 2>/dev/null'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ changedetection_playwright_driver_identifier }} 2>/dev/null'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ changedetection_playwright_driver_identifier }} \
      --log-driver=none \
      --user={{ changedetection_uid }}:{{ changedetection_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ changedetection_container_network }} \
      --env-file={{ changedetection_base_path }}/playwright-env \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ changedetection_playwright_driver_container_tmpfs_tmp_size }} \
      {% for arg in changedetection_playwright_driver_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ changedetection_playwright_driver_container_image }}

{% for network in changedetection_playwright_driver_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ changedetection_playwright_driver_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ changedetection_playwright_driver_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ changedetection_playwright_driver_identifier }} 2>/dev/null'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ changedetection_playwright_driver_identifier }} 2>/dev/null'
Restart=always
RestartSec=30
SyslogIdentifier={{ changedetection_playwright_driver_identifier }}

[Install]
WantedBy=multi-user.target
