[Unit]
Description=Changedetection.io ({{ changedetection_identifier }})
{% for service in changedetection_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in changedetection_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ changedetection_identifier }} 2>/dev/null'
ExecStartPre=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ changedetection_identifier }} 2>/dev/null'

ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ changedetection_identifier }} \
      --log-driver=none \
      --user={{ changedetection_uid }}:{{ changedetection_gid }} \
      --cap-drop=ALL \
      --read-only \
      --network={{ changedetection_container_network }} \
      {% if changedetection_container_http_host_bind_port %}
      -p {{ changedetection_container_http_host_bind_port }}:{{ changedetection_container_http_port }} \
      {% endif %}
      --env-file={{ changedetection_base_path }}/env \
      --label-file={{ changedetection_base_path }}/labels \
      --mount type=volume,src={{ changedetection_data_volume }},dst=/datastore \
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ changedetection_container_tmpfs_tmp_size }} \
      {% for arg in changedetection_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ changedetection_container_image_self_build_name if changedetection_container_image_self_build else changedetection_container_image }}

{% for network in changedetection_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ changedetection_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ changedetection_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ changedetection_identifier }} 2>/dev/null'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ changedetection_identifier }} 2>/dev/null'
Restart=always
RestartSec=30
SyslogIdentifier={{ changedetection_identifier }}

[Install]
WantedBy=multi-user.target
